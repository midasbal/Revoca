.env
.env.local
# Gated Cleanverse documentation (PDFs), never committed. Pattern, not just
# docs/cleanverse.pdf, so a future addition (e.g. docs/cleanverse2.pdf)
# can't slip through by being a different filename.
docs/*.pdf

# Internal planning/notes docs, kept local only. Only README.md files and
# docs/THREAT_MODEL.md, docs/ARCHITECTURE.md, docs/PROJECT.md are tracked.
CLAUDE.md
docs/ROADMAP.md
docs/HACKATHON.md
docs/BUILD_PLAN.md
docs/SUBMISSION.md
docs/OPEN_QUESTIONS.md
docs/CLEANVERSE_API.md
docs/TIER_DISTRIBUTION.md
docs/STRATEGY.md
docs/COMPETITORS.md
docs/DESIGN_A_SPIKE.md
docs/GRIEFING_ANALYSIS.md
node_modules/
dist/
build/
out/
cache/
artifacts/
broadcast/
