# Cleanverse UAT sandbox credentials, never commit real values here.
CLEANVERSE_API_ID=
CLEANVERSE_API_KEY=
MONAD_TESTNET_RPC=
DEPLOYER_PRIVATE_KEY=
CLEANVERSE_SANDBOX_URL=https://uatapi.cleanverse.com/api/cooperate

# Keeper config (backend/src/keeper), all optional for dry-run mode, which
# only needs the Cleanverse credentials above. Required once contracts are
# deployed and the keeper runs for real (dryRun: false).
POOL_MIN_TIER=
KEEPER_POLL_INTERVAL_MS=
COMPLIANCE_REGISTRY_ADDRESS=
REVOCATION_GUARDIAN_ADDRESS=
LENDING_POOL_ADDRESS=
# Deliberately a DIFFERENT key from DEPLOYER_PRIVATE_KEY, see
# docs/THREAT_MODEL.md item 5 on key separation. The keeper only needs
# ComplianceRegistry/RevocationGuardian call authority, not owner/deployer
# authority.
KEEPER_PRIVATE_KEY=

# Local anvil end-to-end rehearsal ONLY (backend/test/e2e-local-rehearsal.test.ts)
#, never a real-value key. Fill in with one of anvil's own printed default
# dev-account private keys (public, well-known, hold no real value; see
# contracts/script/DeployLocal.s.sol's header) when running the rehearsal
# locally. Distinct from KEEPER_PRIVATE_KEY, which is for the real
# sandbox/testnet keeper.
LOCAL_KEEPER_PRIVATE_KEY=

# Attestation service (backend/src/attestor, Phase 2b / Design B), signs
# EIP-712 ComplianceAttestations for ComplianceRegistry.submitAttestation.
# Deliberately a SEPARATE key from KEEPER_PRIVATE_KEY/DEPLOYER_PRIVATE_KEY,
# see docs/THREAT_MODEL.md's attestor-key section: this key only needs to be
# authorized via the registry's setAttestor(address,true), never owner or
# keeper authority. For local anvil rehearsals, use one of anvil's own
# printed default dev-account keys (public, well-known, hold no real value),
# same as LOCAL_KEEPER_PRIVATE_KEY above.
ATTESTOR_PRIVATE_KEY=

# Gas faucet (backend/src/onboarding/fund.ts's fundGasOnly, POST
# /api/onboarding/fund-gas), funds a small amount of testnet MON to ANY
# connected wallet that has ~0, on demand, no verification gate. Deliberately
# a SEPARATE, small, replenishable wallet, never DEPLOYER_PRIVATE_KEY, since
# anyone who connects a wallet can trigger this. Fund it with free testnet
# MON from Monad's own faucet; top up again if it runs low, a depleted
# faucet fails honestly rather than silently or by falling back to the
# deployer key.
FAUCET_PRIVATE_KEY=
