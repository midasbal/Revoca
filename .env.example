# Cleanverse UAT sandbox credentials, never commit real values here.
CLEANVERSE_API_ID=
CLEANVERSE_API_KEY=
MONAD_TESTNET_RPC=
DEPLOYER_PRIVATE_KEY=
CLEANVERSE_SANDBOX_URL=https://uatapi.cleanverse.com/api/cooperate

# Keeper config (backend/src/keeper), all optional for dry-run mode, which
# only needs the Cleanverse credentials above. Required once contracts are
# deployed and the keeper runs for real (dryRun: false).
POOL_MIN_TIER=
KEEPER_POLL_INTERVAL_MS=
COMPLIANCE_REGISTRY_ADDRESS=
REVOCATION_GUARDIAN_ADDRESS=
LENDING_POOL_ADDRESS=
# Deliberately a DIFFERENT key from DEPLOYER_PRIVATE_KEY, see
# docs/THREAT_MODEL.md item 5 on key separation. The keeper only needs
# ComplianceRegistry/RevocationGuardian call authority, not owner/deployer
# authority.
KEEPER_PRIVATE_KEY=

# Local anvil end-to-end rehearsal ONLY (backend/test/e2e-local-rehearsal.test.ts)
#, never a real-value key. Fill in with one of anvil's own printed default
# dev-account private keys (public, well-known, hold no real value; see
# contracts/script/DeployLocal.s.sol's header) when running the rehearsal
# locally. Distinct from KEEPER_PRIVATE_KEY, which is for the real
# sandbox/testnet keeper.
LOCAL_KEEPER_PRIVATE_KEY=
